# Copy to .env and fill in. Never commit .env.
PORT=3000

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Storage
DB_FILE=data/fieldtrack.db
UPLOAD_DIR=data/uploads

# Optional: email updates to senior officers. Leave SMTP_HOST blank to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

CORS_ORIGIN=
